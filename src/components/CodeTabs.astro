---
/**
 * CodeTabs — A lightweight tabbed code-window for the hero section.
 *
 * Each tab shows a different `.tpr` snippet inside the same macOS-style
 * window chrome. Switching is handled with vanilla JS — no framework deps.
 *
 * Snippets are highlighted at build time (no client-side highlighter) and
 * every source line is wrapped in `.ln`, which LandingMotion uses for the
 * typing reveal. The full text is always in the HTML, so crawlers, copy and
 * no-JS / reduced-motion visitors see the finished code.
 *
 * Usage (MDX):
 *   <CodeTabs tabs={[
 *     { icon: "globe", label: "Web API", file: "api.tpr", code: `...` },
 *     { icon: "terminal", label: "CLI Tool", file: "cli.tpr", code: `...` },
 *   ]} />
 */
export interface Tab {
	/** Lucide icon name, e.g. `globe`, `terminal`, `chart-column`. */
	icon: string;
	label: string;
	file: string;
	code: string;
	/** Command shown in the terminal strip; defaults to `tulpar build <file>`. */
	cmd?: string;
}

export interface Props {
	tabs: Tab[];
	/** Text shown on the live-indicator badge (e.g. "running" / "çalışıyor") */
	liveText?: string;
}

import Icon from './Icon.astro';
import { highlightTulpar } from '../lib/tulpar-highlight';

const { tabs, liveText = 'running' } = Astro.props;

const panels = tabs.map((tab) => ({
	...tab,
	html: highlightTulpar(tab.code),
	cmd: tab.cmd ?? `tulpar build ${tab.file}`,
}));
---

<div class="tlp-hero__preview">
	<div class="tlp-window tlp-window--tabbed not-content" data-codetabs>
		<div class="tlp-window__bar">
			<span class="tlp-window__dot tlp-window__dot--r"></span>
			<span class="tlp-window__dot tlp-window__dot--y"></span>
			<span class="tlp-window__dot tlp-window__dot--g"></span>

			<div class="tlp-window__tabs" role="tablist">
				{tabs.map((tab, i) => (
					<button
						class:list={['tlp-window__tab', { 'is-active': i === 0 }]}
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						data-tab-index={i}
					>
						<Icon name={tab.icon} size={14} class="tlp-window__tab-icon" />
						{tab.label}
					</button>
				))}
			</div>

		</div>

		{panels.map((panel, i) => (
			<div
				class:list={['tlp-window__panel', { 'is-active': i === 0 }]}
				role="tabpanel"
				data-panel-index={i}
			>
				<div class="tlp-window__filename">
					<span>{panel.file}</span>
				</div>
				<pre class="tlp-window__code"><code set:html={panel.html} /></pre>
				<div class="tlp-window__term">
					<span class="tlp-prompt">$</span>
					<span class="ln tlp-window__cmd">{panel.cmd}</span><span class="tlp-caret" aria-hidden="true"></span>
					<span class="tlp-window__live">{liveText}</span>
				</div>
			</div>
		))}
	</div>
</div>

<script>
	function initCodeTabs() {
		document.querySelectorAll<HTMLElement>('[data-codetabs]').forEach((root) => {
			const tabs = root.querySelectorAll<HTMLButtonElement>('[role="tab"]');
			const panels = root.querySelectorAll<HTMLElement>('[role="tabpanel"]');

			tabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const idx = tab.dataset.tabIndex;

					tabs.forEach((t) => {
						t.classList.remove('is-active');
						t.setAttribute('aria-selected', 'false');
					});
					panels.forEach((p) => p.classList.remove('is-active'));

					tab.classList.add('is-active');
					tab.setAttribute('aria-selected', 'true');
					const targetPanel = root.querySelector<HTMLElement>(
						`[data-panel-index="${idx}"]`,
					);
					if (targetPanel) {
						targetPanel.classList.add('is-active');
						root.dispatchEvent(
							new CustomEvent('tlp:tabchange', { detail: { panel: targetPanel } }),
						);
					}
				});
			});
		});
	}

	if (typeof window !== 'undefined') {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initCodeTabs);
		} else {
			initCodeTabs();
		}
	}
</script>
